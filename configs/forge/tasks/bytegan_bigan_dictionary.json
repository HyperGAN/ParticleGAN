{
  "schema_version": 1,
  "id": "bytegan_bigan_dictionary",
  "description": "Learn a bidirectional 1-to-1 discrete byte dictionary over all 256 canonical uint8 bytes on {-1, +1}^8 with a joint BiGAN (G(z), E(x), D(x, z)) and 256 zero-sigma ParticlePrior codes, achieving exact forward generation, exact byte reconstruction G(E(x)), and exact 1-to-1 encoder-to-particle indexing across five final clean live checks.",
  "adapter": "bytegan_bigan",
  "retained_question_ids": [
    "stretch-bytegan-bigan-dictionary"
  ],
  "research_artifacts": {
    "readout": "reports/forge/bytegan-stretch/README.md",
    "api_publication": "reports/toy_audit/api_contract/bytegan/publication.json"
  },
  "task_cohort": "component_output_transport_v1",
  "execution": {
    "initializer": "deterministic_orthogonal",
    "execution_path": "public_components",
    "host": "bytegan_bigan_dictionary",
    "steps": 6000,
    "prior": {
      "kind": "particle_cloud",
      "sigma": 0.0,
      "standardize": false,
      "exception_reason": "Exact-capacity zero-sigma discrete ParticlePrior (256 particles for 256 uint8 bytes) required to test bidirectional 1-to-1 byte dictionary generation and encoder particle indexing without MoG kernel smoothing."
    },
    "protocol": "screening",
    "produces_state": true,
    "prior_contract": "recipe_owned_v1",
    "transport_consumer": "output_marginal_v1",
    "host_definition": {
      "case_id": "api-bytegan-bigan-dictionary",
      "kind": "bytegan_bigan_dictionary",
      "target": "Uniform random uint8 bytes (0..255) on {-1, +1}^8 with joint BiGAN (G(z), E(x), D(x, z)) bidirectional 1-to-1 dictionary lookup",
      "resources": {
        "num_particles": 256,
        "z_dim": 8,
        "batch_size": 128
      },
      "model": {
        "family": "simple_mlp_bigan",
        "hidden": 128,
        "layers": 2,
        "x_dim": 8,
        "z_dim": 8,
        "joint_in_dim": 16,
        "fourier": 2
      },
      "bit_tol": 0.25,
      "steps": 6000
    }
  },
  "evaluation": {
    "sampling_contract_version": 1,
    "sampling_law": "generated_and_paired_reconstructed_prior_without_output_noise",
    "eval_output_noise": "clean",
    "scoring_weights": "live",
    "kind": "bytegan_bigan_dictionary",
    "eval_samples": 256,
    "observations": 24,
    "minimum_stable_checks": 5,
    "guards": {
      "finite_state": true,
      "optimizer_roles": [
        "generator",
        "encoder",
        "prior",
        "discriminator"
      ],
      "exact_optimizer_updates": true,
      "mechanism_exercised": true,
      "rng_isolation": true
    },
    "thresholds": [
      [
        "finite_fraction",
        "==",
        1.0
      ],
      [
        "valid_particle_fraction",
        "==",
        1.0
      ],
      [
        "valid_unique_bytes",
        "==",
        256
      ],
      [
        "rms_bit_error",
        "<=",
        0.12
      ],
      [
        "recon_valid_exact_bytes",
        "==",
        256
      ],
      [
        "recon_rms_bit_error",
        "<=",
        0.12
      ],
      [
        "encoder_particle_bijection_bytes",
        "==",
        256
      ]
    ],
    "sources": {
      "benchmarks/toy_audit/api_bytegan.py": "e56edc04410c9d72e635b96b5ccb24f989aa6964f9c592fcfa32efeb122b0591",
      "experiments/forge/bytegan.py": "1e56d436d1204ab1d76f9e20f0215cb400425742004ff532e0f96860d6eff8f4"
    }
  },
  "resources": {
    "gpus": 1,
    "gpu_memory_mb": 2048,
    "cpu_threads": 1,
    "timeout_seconds": 900
  },
  "requires_capabilities": [
    "public_components",
