{
  "schema_version": 1,
  "id": "model_vae_categorical",
  "adapter": "public_api_model_toy",
  "description": "Can a genuine particle VAE retain the input and posterior noise while independently generating both target modes? New constrained two-mode seed-0 public-component cohort; does not reproduce or qualify historical 100-mode results. Hard routing has constant log(K) KL and biased straight-through gradients; categorical routing uses the public leave-one-out score estimator and a variable KL. A stochastic no-KL AE is not a VAE.",
  "execution": {
    "initializer": "deterministic_orthogonal",
    "host": "api-model-vae-categorical",
    "steps": 1200,
    "prior": {
      "kind": "mog",
      "sigma": 0.025,
      "standardize": false
    },
