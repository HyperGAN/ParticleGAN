    "protocol": "screening",
    "produces_state": false,
    "host_source": "benchmarks/toy_audit/api_model_vae.py",
    "execution_path": "public_components",
    "recipe_fields": {
      "model": "gan",
      "conditioning": "scalar",
      "encoder_mode": "categorical",
      "observation_sigma": 0.03
